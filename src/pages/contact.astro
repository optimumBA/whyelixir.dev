---
import Information from "../layouts/Information.astro";
import site from '../../agent-site.json';
const { organization, contact } = site;
const { address } = organization;
---
<Information title="Contact" description="Get in touch with Optimum Tech about WhyElixir.">
  <p>Have a question about Elixir, a project in mind or a correction to this website?</p>
  <p>Email <a href={`mailto:${contact}`}>{contact}</a>.</p>
  <h2>Mailing address</h2>
  <p>{organization.legalName}<br />{address.streetAddress}<br />{address.addressLocality}, {address.addressRegion} {address.postalCode}<br />United States</p>
  <p>This is a mailing address, not a visitor location.</p>
</Information>
