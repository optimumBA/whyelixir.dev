---
import site from '../../agent-site.json';
import AgentMetadata from '../components/AgentMetadata.astro';
import SiteFooter from '../components/SiteFooter.astro';
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.origin).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preload" href="/fonts/montserrat-v31-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/css/app.css" />
    <AgentMetadata />
  </head>
  <body class="information-page">
    <header class="information-header"><a href="/" aria-label="WhyElixir home">WhyElixir</a></header>
    <main class="information-content">
      <a class="information-back" href="/">← Why Elixir?</a>
      <h1>{title}</h1>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
