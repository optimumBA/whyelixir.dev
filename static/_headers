/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://plausible.io; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://plausible.io; form-action 'self'

https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:deployment.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/montserrat-v31-latin.woff2
  Cache-Control: public, max-age=31536000, immutable
