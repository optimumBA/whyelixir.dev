{
  "name": "whyelixir",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/app.css -o ./static/css/app.css --minify",
    "build": "npm run build:css && astro build && python3 scripts/build-agent-content.py",
    "watch:css": "tailwindcss -i ./assets/css/app.css -o ./static/css/app.css --watch",
    "serve": "npm run build:css && concurrently \"npm run watch:css\" \"astro dev\"",
    "preview": "astro preview"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.2.2",
    "concurrently": "^9.0.0",
    "tailwindcss": "4.2.2",
    "astro": "7.3.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
